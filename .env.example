# Copy to .env (same folder) and fill in what you use. Read by docker compose
# and by the backend; .env is git-ignored.

# Linked at the end of every Freelancer.com bid draft
PORTFOLIO_URL=

# Phone alerts for hot requests: make a bot with @BotFather, message it once,
# then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Reddit "script" app (reddit.com/prefs/apps) so Reddit stops rate-limiting
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
